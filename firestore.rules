rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'pandirstok.stok1250@gmail.com' ||
        request.auth.token.email == 'pandir@pandirstore.com' ||
        request.auth.token.email == 'admin@pandirstore.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'kasir') == 'admin')
      );
    }

    // --- Collections ---

    // Users: Users can read, create, and update their own document, or Admin can manage all users.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Products: Signed in users can read, create, and update products/stock. Admin can delete.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Categories: Signed in users can read and manage categories.
    match /categories/{categoryId} {
      allow read, write: if isSignedIn();
    }

    // Transactions: Signed in users can read and create. Admin can update/delete.
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Customer Debts: Signed in users can read, create, and update installments.
    match /customer_debts/{debtId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Petty Cash Logs: Signed in users can read and create.
    match /petty_cash_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Closing Reports: Signed in users can read and create.
    match /closing_reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Capital Logs: Signed in users can read and create capital entries.
    match /capital_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Stock Flow Logs: Signed in users can read and create stock audit logs.
    match /stock_flow_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Stock Opname Reports: Signed in users can read and create stock opname reports.
    match /stock_opname_reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Settings: Signed in users can read and update system settings.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Active Carts: Read and write active shopping cart session for real-time POS persistence.
    match /active_carts/{cartId} {
      allow read, write: if true;
    }
  }
}
